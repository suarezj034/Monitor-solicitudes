# ===== Marca blanca (cliente que usa esta instalación) =====
# Nombre que se muestra junto al logo (login, encabezados, PDFs).
NEXT_PUBLIC_COMPANY_NAME=Tu Empresa
# Opcional: si no se pone, se usa el archivo public/logo.svg (reemplazalo
# por el logo del cliente manteniendo ese mismo nombre de archivo).
# NEXT_PUBLIC_LOGO_URL=

# ===== Acceso de clientes (login de la web) =====
# Usuario y contraseña ÚNICOS compartidos para ver el monitor.
VIEW_USER=cliente
VIEW_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=pon-un-secreto-largo-y-aleatorio

# ===== Códigos de acceso por sector =====
# Cada sector ve únicamente sus propias solicitudes. Formato SECTOR:CODIGO
SECTOR_CODES=PROD:Prod7,MANT:Mant2,Control de calidad:Ctrl3,QA:Qa7,ADM:Adm1,RRHH:Rrhh9,GG:Gg1,PRECIOS APIS:Apis9,Depósito:Depo5,DESA:Desa1

# Código maestro: ve TODOS los sectores (gerencia / compras).
MASTER_CODE=Master6

# ===== Administración (/admin y /gestion) =====
# Contraseña para subir el .xlsx y para la gestión de compras/presupuestos.
ADMIN_PASSWORD=cambiame

# ===== Gestión de compras — lectura de documentos con IA (opcional) =====
# Sin esta clave, la gestión funciona con carga MANUAL (gratis).
# Con la clave, el botón "Leer con IA" (Google Gemini) completa los campos solo.
# Se obtiene GRATIS en https://aistudio.google.com/apikey  (nivel gratuito).
# GEMINI_API_KEY=AIza...

# ===== Webhook de OC por mail (opcional) =====
# Secreto que valida las llamadas a /api/webhook/orden-compra (ej. desde un
# flujo de Power Automate disparado al llegar un mail con la OC en copia).
# Generá uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# WEBHOOK_SECRET=

# ===== Vercel Blob =====
# Se crea automáticamente al conectar un Blob Store en Vercel.
# En local es OPCIONAL: si no está, los datos se guardan en ./.data/solicitudes.json
# BLOB_READ_WRITE_TOKEN=

# ===== Archivado a almacenamiento frío (opcional — lo decide el operador, no el cliente) =====
# Plan "Base" vs. "Ampliado": define cuántos días después de que una compra
# quede COMPRADA (o un pedido de transporte CONFIRMADO) se mueve su documento
# a almacenamiento frío (Cloudflare R2) para no gastar la cuota de Vercel Blob.
#   - Sin definir o "0": retención ILIMITADA (plan Ampliado) — nunca se archiva.
#   - Un número de días, ej. "30": plan Base — se archiva a partir de esa antigüedad.
# RETENCION_ARCHIVOS=30

# Credenciales de Cloudflare R2 (gratis hasta 10 GB, sin costo de bajada).
# Obligatorias solo si RETENCION_ARCHIVOS está configurado.
# Se generan en el dashboard de Cloudflare: R2 → Manage API Tokens.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Secreto que valida las llamadas de Vercel Cron a /api/cron/archivar.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=
