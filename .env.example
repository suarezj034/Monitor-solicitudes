# ===== Acceso de clientes (login de la web) =====
# Usuario y contraseña ÚNICOS compartidos para ver el monitor.
VIEW_USER=cliente
VIEW_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=pon-un-secreto-largo-y-aleatorio

# ===== Códigos de acceso por sector =====
# Cada sector ve únicamente sus propias solicitudes. Formato SECTOR:CODIGO
SECTOR_CODES=PROD:Prod7,MANT:Mant2,Control de calidad:Ctrl3,QA:Qa7,ADM:Adm1,RRHH:Rrhh9,GG:Gg1,PRECIOS APIS:Apis9,Depósito:Depo5,DESA:Desa1

# Código maestro: ve TODOS los sectores (gerencia / compras).
MASTER_CODE=Master6

# ===== Administración (/admin y /gestion) =====
# Contraseña para subir el .xlsx y para la gestión de compras/presupuestos.
ADMIN_PASSWORD=cambiame

# ===== Gestión de compras — lectura de documentos con IA (opcional) =====
# Sin esta clave, la gestión funciona con carga MANUAL (gratis).
# Con la clave, el botón "Leer con IA" (Google Gemini) completa los campos solo.
# Se obtiene GRATIS en https://aistudio.google.com/apikey  (nivel gratuito).
# GEMINI_API_KEY=AIza...

# ===== Vercel Blob =====
# Se crea automáticamente al conectar un Blob Store en Vercel.
# En local es OPCIONAL: si no está, los datos se guardan en ./.data/solicitudes.json
# BLOB_READ_WRITE_TOKEN=
